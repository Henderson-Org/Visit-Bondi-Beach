# Set to "true" ONLY in Vercel's Production environment once the real domain is attached.
# Leaving it unset keeps every deployment noindex AND disables ads/analytics (safe for staging).
NEXT_PUBLIC_IS_PRODUCTION=

# Optional: override the canonical origin. Defaults to https://www.visitbondibeach.com
# in production and the Vercel preview URL otherwise.
NEXT_PUBLIC_SITE_ORIGIN=

# Google Analytics 4 (migrated). Default in code: G-KQ2SFKV2EZ. Override here if needed.
NEXT_PUBLIC_GA_ID=

# Google AdSense (direct). Default publisher in code: ca-pub-3425864271290233.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Numeric ad-unit slot id for the single in-article unit (create in AdSense → Ad units).
# Leave blank and no ad renders (safe). Deliberate placement only — NOT Auto Ads.
NEXT_PUBLIC_AD_SLOT_INARTICLE=

# Editorial author (first-person local voice). Set a real name + switch type to 'Person'
# for stronger E-E-A-T once a named author/bio exists.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_TYPE=

# Daily Weather & Surf Summary module.
# Weather + surf providers (Open-Meteo) need NO API key. Data is fetched server-side
# and cached (~30 min). See docs/weather-surf-conditions.md.
# For launch, review Open-Meteo's commercial terms (may require a key) or swap the
# provider in lib/conditions/service.ts.
#
# Tide is OPTIONAL and OFF by default (tide data is omitted, never fabricated).
# Set a WorldTides API key to switch it on; tide is cached ~6h to conserve credits.
TIDE_API_KEY=

# --- Affiliate monetisation (Stay section, Travelpayouts) --------------------
# The Travelpayouts MARKER and per-program ids are NOT secrets — they appear in
# every affiliate URL by design — so they are NEXT_PUBLIC_ (safe in the browser).
# Until these are set, the Stay CTAs still work: they link straight to the provider
# search, just untracked/unmonetised. Set them to switch monetisation on. Placeholders
# only below — put the real values in Vercel → Project → Settings → Environment
# Variables (Production), never in a committed file.
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
# Travelpayouts program ("p") id per partner. Find each under Travelpayouts →
# the specific offer/program. Leave blank to keep that provider untracked.
NEXT_PUBLIC_TP_P_BOOKING=
NEXT_PUBLIC_TP_P_HOSTELWORLD=
NEXT_PUBLIC_TP_P_TRIPADVISOR=

# The PRIVATE Travelpayouts API token is NOT used by the site and must never be
# added as a NEXT_PUBLIC_ variable. If you ever need it for a server-only script,
# store it as a plain (non-public) env var so it is never sent to the browser.
# TRAVELPAYOUTS_API_TOKEN=

# ---------------------------------------------------------------------------
# First-party analytics (/admin dashboard). See docs/analytics.md.
# ---------------------------------------------------------------------------
# Postgres connection string. This is the permanent, durable store for analytics -
# raw events are kept indefinitely and nothing in this project deletes them.
#
# PREFER ANALYTICS_DATABASE_URL when the Vercel project has more than one database
# attached. POSTGRES_URL / DATABASE_URL are generic names that another integration
# may also set, and because the app creates its own table on first use, resolving to
# the wrong database would put the analytics table inside a different application's
# schema. Setting this explicitly removes that ambiguity.
ANALYTICS_DATABASE_URL=

# Fallbacks for the ordinary single-database setup. Vercel/Neon set one of these
# automatically when you attach a store to the project.
POSTGRES_URL=
DATABASE_URL=

# Master switch for RECORDING page views. Off unless this is exactly "true", so
# local development, CI and tests never write into production analytics.
ANALYTICS_ENABLED=

# Client-side switch for the tracking beacon. Must ALSO be "true" for any event to
# be sent. Keep both set only in the Production environment.
NEXT_PUBLIC_ANALYTICS_ENABLED=

# Admin password for /admin. Use a long, high-entropy value - it is the primary
# protection on the dashboard. Never commit a real value.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. MUST be at least 32 characters;
# shorter values are refused and admin access stays closed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
