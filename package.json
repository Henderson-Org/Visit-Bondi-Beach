{
  "name": "visitbondibeach",
  "version": "0.1.0",
  "private": true,
  "description": "VisitBondiBeach.com \u2014 modern Next.js rebuild migrated from Squarespace",
  "scripts": {
    "dev": "next dev",
    "build:search": "node scripts/build-search-index.mjs",
    "build:translations": "node scripts/build-translations.mjs",
    "translations:verify": "node scripts/verify-translation-parity.mjs",
    "build": "node scripts/build-translations.mjs && node scripts/verify-translation-parity.mjs && node scripts/build-search-index.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "crawl": "node migration/scripts/crawl-inventory.mjs",
    "build:content": "node scripts/build-content.mjs",
    "build:bodies": "node scripts/build-bodies.mjs",
    "seo:qa": "node scripts/seo-qa.mjs",
    "audit:stay": "node --experimental-strip-types scripts/audit-accommodation.ts",
    "test": "vitest run",
    "events:verify": "node scripts/verify-events.mjs",
    "restaurants:verify": "node scripts/restaurants-audit.mjs",
    "seo:regression": "node scripts/seo-regression.mjs",
    "seo:check-index": "node scripts/check-indexability.mjs",
    "freshness:audit": "node scripts/freshness-audit.mjs",
    "analytics:migrate": "node --experimental-strip-types scripts/migrate-analytics.ts",
    "schema:audit": "node scripts/schema-audit.mjs",
    "links:fix": "node scripts/fix-internal-links.mjs",
    "freshness:classify": "node scripts/classify-freshness.mjs",
    "water:snapshot": "node scripts/snapshot-water-quality.mjs",
    "build:rescue-csv": "node scripts/build-rescue-csv.mjs"
  },
  "dependencies": {
    "isbot": "^5.2.1",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7",
    "vitest": "^2.1.8"
  }
}
